{
  "name": "agy-foreman",
  "version": "0.2.2",
  "description": "Hand plan tasks from Claude Code to Gemini 3.8 Flash through the Antigravity CLI, and merge only what passes your tests.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mountaser/agy-foreman.git"
  },
  "homepage": "https://github.com/mountaser/agy-foreman#readme",
  "bugs": {
    "url": "https://github.com/mountaser/agy-foreman/issues"
  },
  "type": "module",
  "bin": {
    "agy-foreman": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "tsc --noEmit && prettier --check src test && vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "prepublishOnly": "npm run test:ci && npm run build"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "antigravity",
    "agy",
    "gemini",
    "delegation"
  ],
  "author": "Mountaser Halak (https://mountaserhalak.com)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.8.4",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
